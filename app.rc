#include <winuser.h>
#include <winver.h>
1 RT_MANIFEST "app.manifest"
2 ICON "openlasso.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x4L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "OpenLasso"
      VALUE "FileDescription", "OpenLasso - process priority, affinity and power manager"
      VALUE "OriginalFilename", "OpenLasso.exe"
      VALUE "CompanyName", "watergamer111"
      VALUE "LegalCopyright", "Copyright (c) 2026 watergamer111"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
